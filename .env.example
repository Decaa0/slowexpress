# Used by docker-compose.yml. Copy to .env:  cp .env.example .env
# Placeholders for LOCAL use only. Never commit a real .env or real secrets.
POSTGRES_USER=slowexpress
POSTGRES_PASSWORD=change-me-local-db-password
POSTGRES_DB=slowexpress
# Long random string that signs login tokens
JWT_SECRET=change-me-long-random-string-for-local-use
# Password the seed gives the synthetic demo accounts
DEMO_PASSWORD=change-me-local-demo-password
# Host port for the app (the container listens on 8080)
APP_PORT=8080
