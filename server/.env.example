# Copy to .env for local use. Placeholders only: never commit real values.
# Postgres connection string (local docker-compose: see docker-compose.yml)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5433/slowexpress"
# Long random string used to sign login tokens (secret)
JWT_SECRET="change-me-long-random-string"
# Password given to the synthetic demo accounts by the seed (secret, never shown on screen)
DEMO_PASSWORD="change-me-demo-password"
# Port the API listens on (Cloud Run sets this itself)
PORT=4000
# Browser origin allowed to call the API
CORS_ORIGIN="http://localhost:5173"
# Optional: only for tests, a separate empty database
# TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5433/slowexpress_test"
